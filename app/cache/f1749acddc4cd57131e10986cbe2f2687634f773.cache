a:2:{s:4:"data";a:12:{i:0;a:3:{s:11:"category_id";i:7;s:13:"category_name";s:18:"Biography & Memoir";s:11:"description";s:136:"A detailed description of a person's life. Biographies are written by someone else, while memoirs are written by the subject themselves.";}i:1;a:3:{s:11:"category_id";i:10;s:13:"category_name";s:20:"Business & Economics";s:11:"description";s:86:"Books focused on commerce, finance, management, entrepreneurship, and economic theory.";}i:2;a:3:{s:11:"category_id";i:12;s:13:"category_name";s:21:"Children's Literature";s:11:"description";s:113:"Books intended for children and young people, ranging from picture books for toddlers to novels for young adults.";}i:3;a:3:{s:11:"category_id";i:3;s:13:"category_name";s:7:"Fantasy";s:11:"description";s:160:"Stories set in an imaginary universe, often but not always without any locations, events, or people from the real world, featuring magic and mythical creatures.";}i:4;a:3:{s:11:"category_id";i:5;s:13:"category_name";s:18:"Historical Fiction";s:11:"description";s:133:"A literary genre in which the plot takes place in a setting located in the past, capturing the details of the time period accurately.";}i:5;a:3:{s:11:"category_id";i:8;s:13:"category_name";s:7:"History";s:11:"description";s:96:"Non-fiction books that record, analyze, and interpret past events, societies, and civilizations.";}i:6;a:3:{s:11:"category_id";i:6;s:13:"category_name";s:6:"Horror";s:11:"description";s:115:"Fiction intended to scare, unsettle, or horrify the reader, often including supernatural or psychological elements.";}i:7;a:3:{s:11:"category_id";i:2;s:13:"category_name";s:18:"Mystery & Thriller";s:11:"description";s:113:"Genre of fiction in which a detective, either an amateur or a professional, solves a crime or a series of crimes.";}i:8;a:3:{s:11:"category_id";i:4;s:13:"category_name";s:7:"Romance";s:11:"description";s:134:"Novels that focus on a romantic relationship between two or more people, usually with an emotionally satisfying and optimistic ending.";}i:9;a:3:{s:11:"category_id";i:9;s:13:"category_name";s:20:"Science & Technology";s:11:"description";s:119:"Works covering scientific principles, technological advancements, computer science, engineering, and the natural world.";}i:10;a:3:{s:11:"category_id";i:1;s:13:"category_name";s:15:"Science Fiction";s:11:"description";s:181:"Speculative fiction dealing with imaginative concepts such as futuristic science, space travel, time travel, faster-than-light travel, parallel universes, and extraterrestrial life.";}i:11;a:3:{s:11:"category_id";i:11;s:13:"category_name";s:9:"Self-Help";s:11:"description";s:135:"Non-fiction books written with the intention to instruct its readers on solving personal problems and improving aspects of their lives.";}}s:7:"expires";i:1769676509;}